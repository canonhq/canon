# GitHub App
GH_APP_ID=                # GitHub App ID (e.g., 2813462)
GH_PRIVATE_KEY=           # GitHub App private key (PEM format, newlines as \n)
GH_WEBHOOK_SECRET=        # GitHub App webhook secret
GH_INSTALLATION_ID=       # GitHub App installation ID (e.g., 108540641)

# Anthropic
ANTHROPIC_API_KEY=        # Claude API key for agent runtime

# Authentication (OIDC)
# Choose one of the following auth providers:
# - Generic OIDC (recommended for self-hosted)
# - GitHub OAuth (for GitHub-only deployments)

# Generic OIDC Provider
OIDC_ISSUER=              # OIDC issuer URL (e.g., https://accounts.zitadel.com)
OIDC_CLIENT_ID=           # OIDC client ID
OIDC_CLIENT_SECRET=       # OIDC client secret
OIDC_SCOPES=              # Space-separated scopes (default: openid profile email)

# GitHub OAuth
GITHUB_OAUTH_CLIENT_ID=   # GitHub OAuth app client ID
GITHUB_OAUTH_CLIENT_SECRET=  # GitHub OAuth app client secret
GITHUB_OAUTH_REDIRECT_URI=   # Redirect URI (e.g., https://your-domain/auth/github/callback)

# GitHub Issues (optional — for ticket sync via GitHub)
GITHUB_TOKEN=             # GitHub PAT for ticket operations
GITHUB_OWNER=             # Default org/owner (e.g., your-org)
GITHUB_REPO=              # Default repo (e.g., your-repo)

# Jira (optional — for ticket sync via Jira)
JIRA_HOST=                # e.g., yourcompany.atlassian.net
JIRA_EMAIL=               # Jira service account email
JIRA_API_TOKEN=           # Jira API token

# Linear (optional — for ticket sync via Linear)
LINEAR_API_KEY=           # Linear API key

# App
LOG_LEVEL=info
