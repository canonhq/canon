# GitHub App
GH_APP_ID=                # GitHub App ID (e.g., 2813462)
GH_PRIVATE_KEY=           # GitHub App private key (PEM format, newlines as \n)
GH_WEBHOOK_SECRET=        # GitHub App webhook secret
GH_INSTALLATION_ID=       # GitHub App installation ID (e.g., 108540641)

# Anthropic
ANTHROPIC_API_KEY=        # Claude API key for agent runtime

# GitHub Issues (optional — for ticket sync via GitHub)
GITHUB_TOKEN=             # GitHub PAT for ticket operations
GITHUB_OWNER=             # Default org/owner (e.g., Gerner-Ventures)
GITHUB_REPO=              # Default repo (e.g., gv-exp-specwright)

# Jira (optional — for ticket sync via Jira)
JIRA_HOST=                # e.g., yourcompany.atlassian.net
JIRA_EMAIL=               # Jira service account email
JIRA_API_TOKEN=           # Jira API token

# Linear (optional — for ticket sync via Linear)
LINEAR_API_KEY=           # Linear API key

# Slack (not yet implemented)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Database (not yet implemented)
DATABASE_URL=

# App
LOG_LEVEL=info
