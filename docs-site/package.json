{
  "name": "canon-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen-refs": "cd .. && uv run python docs-site/.vitepress/scripts/gen-refs.py",
    "dev": "vitepress dev",
    "prebuild": "which uv >/dev/null 2>&1 && npm run gen-refs || echo 'Skipping gen-refs (uv not available, using committed files)'",
    "build": "vitepress build",
    "preview": "vitepress preview"
  },
  "devDependencies": {
    "vitepress": "^1.6.3",
    "vitepress-plugin-mermaid": "^2.0.17",
    "mermaid": "^11.4.1",
    "vue": "^3.5.13"
  }
}
